# Optional AI generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WEEKLY_INSIGHT_USE_OPENAI=false

# Optional topic discovery sources.
NEWS_API_KEY=
SERP_API_KEY=

# Future publishing integrations. Do not use until human approval workflow is built.
LINKEDIN_ACCESS_TOKEN=
WHATSAPP_API_TOKEN=

# Portfolio URL used inside generated drafts.
WEEKLY_INSIGHT_PORTFOLIO_BASE_URL=https://your-portfolio-domain.com

# Draft safety default. Use "review" or "draft"; never "published" from this script.
WEEKLY_INSIGHT_STATUS=review
